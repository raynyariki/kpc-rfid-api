# Settings that can change between computers (your laptop, the test server,
# the live server at KPC) live here instead of inside the code.
# Never commit this file to Git: later it will hold passwords and secrets.

# The port number our server listens on. http://localhost:3000
PORT=3000

# The most trucks allowed inside the premises at once (KPC document: 6).
MAX_OCCUPANCY=6

# Scans of the same tag at the same gate within this many seconds
# count as one scan (the reader sees a tag many times as it passes).
DUPLICATE_WINDOW_SECONDS=10